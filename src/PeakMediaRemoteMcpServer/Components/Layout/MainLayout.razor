@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app">
    <header class="app-header" data-app-header>
        <span class="brand">PeakMedia Gateway</span>
        <nav class="app-nav" aria-label="Primary">
            <a href="/" aria-current="@CurrentFor("")">My usage</a>
            @if (_isAdmin)
            {
                <a href="/admin" aria-current="@CurrentFor("admin")">Usage</a>
                <a href="/admin/cache" aria-current="@CurrentFor("admin/cache")">Cache</a>
            }
        </nav>
        <div class="header-end">
            <span class="who">@_email</span>
            <div class="theme-choice">
                <label for="theme-select">Theme</label>
                <BbNativeSelect TValue="string" Id="theme-select" Size="NativeSelectSize.Small"
                                Value="_theme" ValueChanged="OnThemeChanged">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="system">System</option>
                </BbNativeSelect>
            </div>
            <form class="signout-form" method="post" action="/signout">
                <AntiforgeryToken />
                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">Sign out</BbButton>
            </form>
        </div>
        @* Below 480 CSS px the navigation, email, theme and Sign out move into this sheet (app.css). *@
        <div class="menu-trigger">
            <BbSheet Open="_menuOpen" OpenChanged="OnMenuOpenChanged">
                <BbSheetTrigger AsChild="true">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="Open menu">
                        <LucideIcon Name="menu" Size="20" aria-hidden="true" />
                    </BbButton>
                </BbSheetTrigger>
                <BbSheetContent Class="menu-sheet" data-menu-sheet>
                    <BbSheetHeader>
                        <BbSheetTitle>Menu</BbSheetTitle>
                    </BbSheetHeader>
                    <nav class="sheet-nav" aria-label="Menu">
                        <a href="/" aria-current="@CurrentFor("")">My usage</a>
                        @if (_isAdmin)
                        {
                            <a href="/admin" aria-current="@CurrentFor("admin")">Usage</a>
                            <a href="/admin/cache" aria-current="@CurrentFor("admin/cache")">Cache</a>
                        }
                    </nav>
                    <div class="sheet-account">
                        <span class="who">@_email</span>
                        <div class="theme-choice">
                            <label for="theme-select-menu">Theme</label>
                            <BbNativeSelect TValue="string" Id="theme-select-menu" Size="NativeSelectSize.Small"
                                            Value="_theme" ValueChanged="OnThemeChanged">
                                <option value="light">Light</option>
                                <option value="dark">Dark</option>
                                <option value="system">System</option>
                            </BbNativeSelect>
                        </div>
                        <form class="signout-form" method="post" action="/signout">
                            <AntiforgeryToken />
                            <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">Sign out</BbButton>
                        </form>
                    </div>
                </BbSheetContent>
            </BbSheet>
        </div>
    </header>

    <main class="app-main" id="main">
        @Body
    </main>

    <footer class="app-footer">@Program.Identity.Name v@(Program.Identity.Version)</footer>
</div>

<BbPortalHost />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string _email = string.Empty;
    private bool _isAdmin;
    private string _theme = "system";
    private bool _menuOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            var caller = Caller.From(user);
            _email = caller.IsSuccess ? caller.Value.Email : string.Empty;
            _isAdmin = AccessRule.IsAdmin(user);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _theme = await JS.InvokeAsync<string>("peakTheme.get");
                StateHasChanged();
            }
            catch (JSDisconnectedException)
            {
                // The page closed before the theme could be read.
            }
        }
    }

    private async Task OnThemeChanged(string? value)
    {
        _theme = value is "light" or "dark" ? value : "system";
        try
        {
            await JS.InvokeVoidAsync("peakTheme.set", _theme);
        }
        catch (JSDisconnectedException)
        {
            // The page closed; nothing to apply.
        }
    }

    /// <summary>
    /// "page" when the current address is <paramref name="relative"/> (marks the current nav item); "true" on the
    /// Usage item while a user's detail page (admin/users/…), which sits under Usage, is shown.
    /// </summary>
    private string? CurrentFor(string relative)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        if (string.Equals(path, relative, StringComparison.OrdinalIgnoreCase))
        {
            return "page";
        }

        return relative == "admin" && path.StartsWith("admin/users/", StringComparison.OrdinalIgnoreCase) ? "true" : null;
    }

    /// <summary>When the person closes the sheet (Escape, overlay, close button), focus returns to the menu button.</summary>
    private async Task OnMenuOpenChanged(bool open)
    {
        _menuOpen = open;
        if (!open)
        {
            try
            {
                await JS.InvokeVoidAsync("peakMenu.restoreFocus");
            }
            catch (JSDisconnectedException)
            {
                // The page closed; nothing to focus.
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // A link chosen in the menu sheet closes it.
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
