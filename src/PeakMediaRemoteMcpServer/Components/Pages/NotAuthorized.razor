@page "/admin"
@page "/admin/{*Path}"
@attribute [Authorize(Policy = McpAuthSetup.DashboardPolicy)]

@* Every /admin address. Administrators' pages arrive in a later epic; until then they get 404 here.
   Everyone else gets Not Authorized (S-05) with HTTP 403 — decided by AccessRule, nothing else. *@

@if (_isAdmin)
{
    <PageTitle>Page not found — PeakMedia Gateway</PageTitle>
    <section class="notice-page">
        <h1>Page not found</h1>
        <p>This administrator page is not available yet.</p>
        <BbLink Href="/">Go to My usage</BbLink>
    </section>
}
else
{
    <PageTitle>Not authorized — PeakMedia Gateway</PageTitle>
    <section class="notice-page">
        <h1>Not authorized</h1>
        <p>This page is for gateway administrators.</p>
        <BbLink Href="/">Go to My usage</BbLink>
    </section>
}

@code {
    [Parameter]
    public string? Path { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            _isAdmin = AccessRule.IsAdmin((await AuthenticationState).User);
        }

        // Only the first (server) render has the HTTP response; the interactive render keeps the page.
        if (HttpContext is not null && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.StatusCode = _isAdmin ? StatusCodes.Status404NotFound : StatusCodes.Status403Forbidden;
        }
    }
}
