@page "/admin/{*Path}"
@attribute [Authorize(Policy = McpAuthSetup.DashboardPolicy)]

@* Every /admin address without a page of its own (Usage is /admin, Cache is /admin/cache).
   Non-administrators get Not Authorized (S-05) with HTTP 403 through AdminOnly; administrators get 404. *@

<AdminOnly>
    <PageTitle>Page not found · PeakMedia Gateway</PageTitle>
    <section class="notice-page">
        <h1>Page not found</h1>
        <p>This administrator page does not exist.</p>
        <BbLink Href="/admin">Go to Usage</BbLink>
    </section>
    <SetStatus Code="StatusCodes.Status404NotFound" />
</AdminOnly>

@code {
    [Parameter]
    public string? Path { get; set; }
}
