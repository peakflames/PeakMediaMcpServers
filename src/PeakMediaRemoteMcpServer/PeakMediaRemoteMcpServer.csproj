<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Container publish (dotnet publish /t:PublishContainer). The tag follows <Version> in
         Directory.Build.props. Not trimmed or single-file: the MCP SDK uses reflection. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>peakflames/peak-media-remote-mcp-server</ContainerRepository>
    <ContainerImageTag>$(Version)</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <ContainerEnvironmentVariable Include="Storage__DatabasePath" Value="/app/data/peakmedia.db" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PeakMediaRemoteMcpServer.Tests" />
    <InternalsVisibleTo Include="PeakMediaRemoteMcpServer.E2E" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="4.2.0" />
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeakMediaMcpTools\PeakMediaMcpTools.csproj" />
  </ItemGroup>

</Project>
