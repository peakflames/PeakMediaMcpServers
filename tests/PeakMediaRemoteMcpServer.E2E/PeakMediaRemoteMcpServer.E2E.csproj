<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end dashboard tests: the real gateway (Program.BuildApp) on real Kestrel in this process,
       the stub OIDC issuer for sign-in, and a real Chromium driven by Playwright. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mvc.Testing copies the gateway's static web assets manifest so its CSS and scripts are served in-process. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeakMediaRemoteMcpServer\PeakMediaRemoteMcpServer.csproj" />
    <ProjectReference Include="..\TestSupport\PeakMediaTestSupport.csproj" />
    <ProjectReference Include="..\StubAuthorizationServer\PeakMediaStubAuthorizationServer.csproj" />
  </ItemGroup>

</Project>
